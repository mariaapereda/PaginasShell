<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PaginasShell.App"
             UserAppTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="Medianoche">#0F1E36</Color>
            <Color x:Key="Marino">#1B365D</Color>
            <Color x:Key="AzulVintage">#2E5E8C</Color>
            <Color x:Key="AzulPolvo">#8FB3D9</Color>
            <Color x:Key="AzulNiebla">#DCE8F3</Color>
            <Color x:Key="Papel">#F4EEE2</Color>
            <Color x:Key="PapelOscuro">#E3D8C4</Color>
            <Color x:Key="Crema">#FBF7EE</Color>
            <Color x:Key="Tinta">#1A2333</Color>
            <Color x:Key="TintaSuave">#4A5568</Color>

            <OnPlatform x:Key="FuenteClasica" x:TypeArguments="x:String">
                <On Platform="WinUI" Value="Georgia" />
                <On Platform="Android" Value="serif" />
                <On Platform="iOS, MacCatalyst" Value="Georgia" />
            </OnPlatform>

            <OnPlatform x:Key="FuenteMaquina" x:TypeArguments="x:String">
                <On Platform="WinUI" Value="Courier New" />
                <On Platform="Android" Value="monospace" />
                <On Platform="iOS, MacCatalyst" Value="Courier" />
            </OnPlatform>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource Papel}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Tinta}" />
                <Setter Property="FontFamily" Value="{StaticResource FuenteClasica}" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <Style x:Key="Rotulo" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource FuenteMaquina}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="3" />
                <Setter Property="TextColor" Value="{StaticResource AzulVintage}" />
            </Style>

            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Crema}" />
                <Setter Property="Stroke" Value="{StaticResource PapelOscuro}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="18" />
            </Style>

            <Style x:Key="MarcoCampo" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Crema}" />
                <Setter Property="Stroke" Value="{StaticResource Marino}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeShape" Value="RoundRectangle 8" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Tinta}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TintaSuave}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource FuenteClasica}" />
                <Setter Property="FontSize" Value="17" />
            </Style>

            <Style TargetType="SearchBar">
                <Setter Property="TextColor" Value="{StaticResource Tinta}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TintaSuave}" />
                <Setter Property="CancelButtonColor" Value="{StaticResource AzulVintage}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontFamily" Value="{StaticResource FuenteClasica}" />
            </Style>

            <Style x:Key="Etiqueta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Marino}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 4,14,4,14" />
                <Setter Property="Padding" Value="12,5" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Marino}" />
                <Setter Property="TextColor" Value="{StaticResource Crema}" />
                <Setter Property="BorderColor" Value="{StaticResource AzulPolvo}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="FontFamily" Value="{StaticResource FuenteClasica}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="22,12" />
                <Setter Property="MinimumHeightRequest" Value="50" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource AzulVintage}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{StaticResource PapelOscuro}" />
                                    <Setter Property="TextColor" Value="{StaticResource TintaSuave}" />
                                    <Setter Property="BorderColor" Value="{StaticResource PapelOscuro}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="BotonSecundario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Marino}" />
                <Setter Property="BorderColor" Value="{StaticResource Marino}" />
                <Setter Property="BorderWidth" Value="2" />
                <Setter Property="FontFamily" Value="{StaticResource FuenteClasica}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="22,12" />
                <Setter Property="MinimumHeightRequest" Value="50" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
